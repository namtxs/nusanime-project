# Backend origin (no trailing slash). Dev: http://localhost:8989
# Production (Vercel): https://api-nusanime.nam.web.id
NUXT_PUBLIC_API_ORIGIN=http://localhost:8989

# Chrome extension zip served from /public
NUXT_PUBLIC_EXTENSION_INSTALL_URL=/nusanime-extension.zip

# Must match backend RESPONSE_AES_KEY (64 hex chars).
# Server-only (not NUXT_PUBLIC_). The Nuxt server masks it into the page payload
# so the browser can decrypt JSON locally — no extra Vercel hop.
NUXT_RESPONSE_AES_KEY=
