# Backend origin (no trailing slash). Dev default: http://localhost:8989
NUXT_PUBLIC_API_ORIGIN=http://localhost:8989

# Chrome extension zip served from /public
NUXT_PUBLIC_EXTENSION_INSTALL_URL=/nusanime-extension.zip

# Must match deploy-backend RESPONSE_AES_KEY (64 hex chars).
# Do not use NUXT_PUBLIC_ here — that inlines the key into window.__NUXT__.config.
NUXT_RESPONSE_AES_KEY=
